{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": "../../..",
    "typeRoots": ["../../../node_modules/@types"],
    "types": []
  },
  "include": ["./*.ts", "../../../src/domain/*.ts"],
  "exclude": ["../../../src/domain/*.test.ts"]
}
